@@ -0,0 +1,129 @@
+#!/usr/bin/env python
+"""
+Example: Control Feetech HLS3915 servo via SCS protocol.
+
+Hardware setup:
+  - HLS3915 uses half-duplex UART (single wire for TX+RX)
+  - Typical interface: USB-to-serial adapter wired to servo bus
+  - Default baud: 1,000,000 bps, default ID: 1
+
+Position encoding:
+  - 0–4095 raw counts over 360°  (≈0.088° per count)
+  - Signed: bit 15 = sign, bits 14:0 = magnitude (scs_tohost convention)
+  - Center = 2048
+
+Speed encoding:
+  - 0 = max speed (no limit)
+  - 1–32767: signed magnitude, bit 15 = direction
+
+Torque limit:
+  - 0–1000 (0.1% units), 1000 = 100% rated torque
+"""
+
+import sys
+import time
+
+# Add reference library to path (adjust as needed for your project layout)
+sys.path.insert(0, "reference/ft_servo/orca_core")
+
+from orca_core.hardware.feetech.port_handler import PortHandler
+from orca_core.hardware.feetech.hls import hls
+from orca_core.hardware.feetech.scservo_def import COMM_SUCCESS
+
+# ── Config ────────────────────────────────────────────────────────────────────
+PORT = "/dev/ttyACM0"
+BAUDRATE = 1_000_000
+SERVO_ID = 1
+
+# Motion parameters
+ACC = 50           # acceleration (0–254); higher = snappier
+SPEED = 1000       # raw speed units; 0 = max
+TORQUE_LIMIT = 500 # 0–1000 (50% rated torque)
+
+# Position targets (raw counts, 0–4095, center = 2048)
+POS_CENTER = 2048
+POS_LEFT   = 1024   # ~90° CCW from center
+POS_RIGHT  = 3072   # ~90° CW  from center
+# ──────────────────────────────────────────────────────────────────────────────
+
+
+def open_port(port: str, baudrate: int) -> PortHandler:
+    ph = PortHandler(port)
+    ph.baudrate = baudrate
+    if not ph.openPort():
+        raise RuntimeError(f"Failed to open port {port}")
+    print(f"Opened {port} @ {baudrate} bps")
+    return ph
+
+
+def wait_done(servo: hls, servo_id: int, timeout: float = 5.0) -> None:
+    """Block until MOVING register clears or timeout."""
+    deadline = time.time() + timeout
+    while time.time() < deadline:
+        moving, result, _ = servo.ReadMoving(servo_id)
+        if result == COMM_SUCCESS and moving == 0:
+            return
+        time.sleep(0.02)
+    print("Warning: motion timeout")
+
+
+def move_to(servo: hls, servo_id: int, position: int,
+            speed: int = SPEED, acc: int = ACC,
+            torque: int = TORQUE_LIMIT) -> None:
+    """Send position command and wait for completion."""
+    result, error = servo.WritePosEx(servo_id, position, speed, acc, torque)
+    if result != COMM_SUCCESS:
+        print(f"WritePosEx failed: result={result}, error={error}")
+        return
+    wait_done(servo, servo_id)
+    pos, result, _ = servo.ReadPos(servo_id)
+    if result == COMM_SUCCESS:
+        print(f"  Reached position: {pos} (target {position})")
+
+
+def read_state(servo: hls, servo_id: int) -> None:
+    pos, result, _ = servo.ReadPos(servo_id)
+    if result != COMM_SUCCESS:
+        print(f"ReadPos failed: {result}")
+        return
+    speed, _, _ = servo.ReadSpeed(servo_id)
+    print(f"State — pos: {pos}, speed: {speed}")
+
+
+def main() -> None:
+    ph = open_port(PORT, BAUDRATE)
+    servo = hls(ph)
+
+    # Ping check
+    model, result, error = servo.ping(SERVO_ID)
+    if result != COMM_SUCCESS:
+        print(f"Ping failed (id={SERVO_ID}): result={result}")
+        ph.closePort()
+        sys.exit(1)
+    print(f"Ping OK — model number: {model}")
+
+    # Enable torque
+    servo.write1ByteTxRx(SERVO_ID, 40, 1)  # HLS_TORQUE_ENABLE = 40
+
+    print("Moving to center...")
+    move_to(servo, SERVO_ID, POS_CENTER)
+
+    print("Moving left...")
+    move_to(servo, SERVO_ID, POS_LEFT)
+
+    print("Moving right...")
+    move_to(servo, SERVO_ID, POS_RIGHT)
+
+    print("Back to center...")
+    move_to(servo, SERVO_ID, POS_CENTER)
+
+    read_state(servo, SERVO_ID)
+
+    # Disable torque
+    servo.write1ByteTxRx(SERVO_ID, 40, 0)
+    ph.closePort()
+    print("Done.")
+
+
+if __name__ == "__main__":
+    main()
