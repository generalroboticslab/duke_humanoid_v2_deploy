+    @classmethod
+    def find_port(cls, baudrate=1000000, timeout=0.1):
+        """
+        Auto-discover the ST Servo port by device name pattern.
+        The servo uses a CH340 USB-Serial chip (usb-1a86_USB_Single_Serial_*),
+        which differs from the IMU's STM32 Virtual ComPort.
+        Falls back to probing if name matching finds nothing.
+        """
+        import glob, os
+
+        # First: match by device name pattern
+        for link in glob.glob("/dev/serial/by-id/*"):
+            name = os.path.basename(link)
+            if "USB_Single_Serial" in name or "1a86" in name:
+                port_path = os.path.realpath(link)
+                return port_path
+
+        # Fallback: probe /dev/ttyACM* with broadcast ping
+        for port_path in sorted(glob.glob("/dev/ttyACM*")):
+            try:
+                s = serial.Serial(port_path, baudrate, timeout=timeout)
+                s.reset_input_buffer()
+                length = 2  # id + length
+                checksum = (~(254 + length + INST_PING)) & 0xFF
+                packet = bytearray([0xFF, 0xFF, 254, length, INST_PING, checksum])
+                s.write(packet)
+                # Try to read response
+                header = s.read(2)
+                if len(header) == 2 and header[0] == 0xFF and header[1] == 0xFF:
+                    s.close()
+                    return port_path
+                s.close()
+            except Exception:
+                pass
+        return None
+
 
