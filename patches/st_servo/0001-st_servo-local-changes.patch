+    def set_position_offset(self, id, target_pos):
+        """
+        Persistently sets the current physical position to report as target_pos.
+        Writes the calculated offset to the Pos Correction register in EPROM.
+        """
+        # Read current reported position
+        p_curr = self.get_position(id)
+        if p_curr is None:
+            print(f"Failed to read position for ID {id}")
+            return False
+
+        # Read current offset from Pos Correction register (Address 31)
+        raw_offset = self.read_word(id, SMS_STS_OFS_L)
+        if raw_offset is None:
+            print(f"Failed to read offset for ID {id}")
+            return False
+
+        # Decode current offset (Bit 11 is direction/sign)
+        magnitude = raw_offset & 0x07FF
+        sign = -1 if (raw_offset & 0x0800) else 1
+        o_curr = sign * magnitude
+
+        # Calculate raw absolute position (without current offset)
+        p_raw = (p_curr - o_curr) % 4096
+
+        # Calculate new offset required to make p_raw report as target_pos
+        o_new = (target_pos - p_raw) % 4096
+
+        # Wrap offset to fit within the servo's +/- 2047 register limit
+        # A shift of +3000 is identical to -1096 in a 4096-step circle
+        if o_new > 2047:
+            o_new -= 4096
+
+        # Encode the new offset back into the servo's sign-magnitude format
+        new_magnitude = abs(o_new)
+        new_raw_offset = new_magnitude & 0x07FF
+        if o_new < 0:
+            new_raw_offset |= 0x0800
+
+        # Split into Low and High bytes for writing
+        offset_l = new_raw_offset & 0xFF
+        offset_h = (new_raw_offset >> 8) & 0xFF
+
+        # EPROM Write Sequence: Unlock -> Write -> Lock
+        self.unlock_eprom(id)
+        self.write_register(id, SMS_STS_OFS_L, [offset_l, offset_h], wait_response=True)
+        self.lock_eprom(id)
+
+        return True
+
     def unlock_eprom(self, id):
         return self.write_register(id, SMS_STS_LOCK, [0])
 
